# shellcheck shell=bash
# ============================================================================
#  Lindos build configuration (SPEC §8)
#
#  Sourced by build/build-iso.sh, build/mkdeb.sh, build/test-qemu.sh and by
#  every chroot hook (staged as /tmp/lindos/config.env inside the chroot).
#
#  Every variable uses the ': "${VAR:=default}"' pattern, so ANY value can be
#  overridden from the environment without editing this file, e.g.
#
#      INCLUDE_STEAM=0 KISAK_MESA=1 make iso
#      BASE_ISO_URL=file:///srv/isos/linuxmint-22.2-xfce-64bit.iso ./build/build-iso.sh
#
#  Keep this file POSIX-ish and side-effect free: no commands, only defaults.
# ============================================================================

# ---------------------------------------------------------------------------
# Product identity (SPEC §2)
# ---------------------------------------------------------------------------
: "${LINDOS_VERSION:=1.0.0}"           # semantic version of this release
: "${LINDOS_CODENAME:=Aurora}"         # release codename
: "${LINDOS_MAINTAINER:=Lindos Team <team@lindos.dev>}"
: "${LINDOS_HOME_URL:=https://lindos.dev}"

# ---------------------------------------------------------------------------
# Base image: Linux Mint 22.x XFCE 64-bit (Ubuntu 24.04 "noble")
# ---------------------------------------------------------------------------
: "${MINT_VERSION:=22.2}"              # Mint point release used as base
: "${MINT_CODENAME:=Zara}"             # Mint codename of that release
: "${BASE_UBUNTU_CODENAME:=noble}"     # Ubuntu codename of the base (apt repos)
: "${BASE_ISO_URL:=https://mirrors.edge.kernel.org/linuxmint/stable/${MINT_VERSION}/linuxmint-${MINT_VERSION}-xfce-64bit.iso}"
# SHA256 of the base ISO.  Empty = skip verification (a WARNING is printed).
# Fill this in for release builds (see the sha256sum.txt next to the ISO on
# the mirror; verify it against linuxmint.com's signed sha256sum.txt.gpg).
: "${BASE_ISO_SHA256:=}"
# Local file name of the cached download (inside out/cache/)
: "${BASE_ISO_FILE:=$(basename "${BASE_ISO_URL}")}"

# ---------------------------------------------------------------------------
# Output layout (relative to the repository root unless absolute)
# ---------------------------------------------------------------------------
: "${OUT_DIR:=out}"                    # everything the build produces
: "${WORK_DIR:=out/work}"              # scratch: extracted ISO + squashfs-root
: "${CACHE_DIR:=out/cache}"            # downloaded base ISO(s)
: "${DEBS_DIR:=out/debs}"              # built .deb packages
: "${ASSETS_DIR:=out/assets}"          # fetch-assets.sh output (theme/icons/fonts)
: "${ISO_NAME:=lindos-${LINDOS_VERSION}-xfce-64bit.iso}"
: "${BUILD_LOG:=out/build.log}"        # tee'd log of build-iso.sh

# ---------------------------------------------------------------------------
# ISO / squashfs parameters
# ---------------------------------------------------------------------------
: "${SQUASHFS_COMP:=zstd}"             # mksquashfs compressor (zstd: fast boot, good ratio)
: "${SQUASHFS_ARGS:=-Xcompression-level 19 -b 1M}"   # extra mksquashfs args
: "${ISO_VOLID:=LINDOS_${LINDOS_VERSION//./_}}"      # ISO9660 volume id (max 32 chars)
: "${ISO_PUBLISHER:=Lindos Team}"
: "${ISO_APPID:=Lindos ${LINDOS_VERSION} ${LINDOS_CODENAME}}"
: "${DISK_INFO:=Lindos ${LINDOS_VERSION} \"${LINDOS_CODENAME}\" - Release amd64}"
# Free space required in OUT_DIR's filesystem before starting (GiB)
: "${MIN_FREE_GB:=15}"
# ISO repack method: "mkisofs" (default; reproduces the base ISO's exact El
# Torito/GPT boot equipment via 'xorriso -indev BASE -report_el_torito
# as_mkisofs') or "replay" ('xorriso -indev BASE -outdev OUT -boot_image any
# replay -map ISO_DIR /').  build-iso.sh falls back to the other automatically.
: "${ISO_METHOD:=mkisofs}"
# Keep the base ISO's --modification-date (= the ISO 9660 "fs uuid" GRUB
# derives; the EFI GRUB in the appended partition may search the medium by it).
: "${KEEP_ISO_MODDATE:=1}"
# Copy /boot/vmlinuz-* + initrd.img-* from the finished chroot into casper/
# (regenerated initrd carries the Lindos plymouth theme; same as Cubic does).
: "${SYNC_CASPER_KERNEL:=1}"
# Extra environment variables forwarded verbatim into the chroot hooks
# (they run under 'env -i' with only the generated /tmp/lindos/config.env).
: "${LINDOS_PASSTHRU_VARS:=HEROIC_VERSION HEROIC_SHA256 PRISM_PPA ACCEPT_MSCOREFONTS_EULA}"

# ---------------------------------------------------------------------------
# What goes into the ISO (chroot hooks read these)
# ---------------------------------------------------------------------------
: "${INCLUDE_WINE:=1}"                 # 60-compat.sh: Ubuntu 'wine' + winetricks (WineHQ staging at OOBE)
: "${INCLUDE_STEAM:=1}"                # 70-gaming.sh: steam-launcher + lutris via install-gaming.sh
: "${INCLUDE_FLATPAK_LAUNCHERS:=0}"    # 70-gaming.sh: pre-install Flatpak launchers (big!) — off by default
: "${KISAK_MESA:=0}"                   # 00-repos.sh: add Kisak fresh Mesa PPA (newer Mesa; opt-in)
: "${ADD_WINEHQ_REPO:=1}"              # 00-repos.sh: add WineHQ noble repo + key (used by OOBE later)
: "${ADD_STEAM_REPO:=1}"               # 00-repos.sh: add Valve's Steam apt repo + key
: "${ADD_FLATHUB:=1}"                  # 00-repos.sh: 'flatpak remote-add flathub' system-wide
: "${ADD_MOZILLA_REPO:=0}"             # 00-repos.sh: Mozilla apt repo (OFF: Mint pins its own firefox)
: "${ENABLE_I386:=1}"                  # 00-repos.sh: dpkg --add-architecture i386 (Wine/Steam need it)

# 10-debloat.sh — packages purged from the live system (space separated).
# Keep tiny (SPEC §8): never purge network/printing basics; thunderbird,
# warpinator, simple-scan, celluloid, drawing are KEPT; mintwelcome is kept
# (its autostart is hidden by lindos-tune / lindos-desktop instead);
# mintreport/apport/whoopsie/kerneloops are DISABLED (below), not purged.
# Absent packages are simply skipped.  Full list + savings: docs/RAM-BUDGET.md
: "${DEBLOAT_PURGE:=hexchat rhythmbox hypnotix onboard gnome-calendar}"
# 10-debloat.sh — services disabled (not purged) — SPEC §8 list
: "${DEBLOAT_DISABLE_SERVICES:=bluetooth.service ModemManager.service apport.service whoopsie.service kerneloops.service brltty.service speech-dispatcher.service NetworkManager-wait-online.service}"

# 20-base.sh — extra packages appended to the base list (space separated)
: "${EXTRA_PACKAGES:=}"

# 30-lindos-debs.sh — installation order of our packages
: "${LINDOS_DEB_ORDER:=lindos-core lindos-desktop lindos-tune lindos-compat lindos-gaming lindos-setup lindos-settings lindos-meta}"
# 30-lindos-debs.sh — also apt-install the packages listed in
# /usr/share/lindos/modes/${TUNE_MODE}/mode.json (best effort, per package)
: "${INSTALL_MODE_PACKAGES:=1}"

# 40-theme.sh
: "${PLYMOUTH_THEME:=lindos}"

# 50-tune.sh — mode whose base tune is baked into the image
: "${TUNE_MODE:=everyday}"

# 70-gaming.sh — items passed to install-gaming.sh --from-chroot when INCLUDE_STEAM=1
: "${GAMING_ITEMS:=steam lutris}"
# 70-gaming.sh — Flatpak apps preinstalled when INCLUDE_FLATPAK_LAUNCHERS=1
: "${FLATPAK_LAUNCHERS:=org.prismlauncher.PrismLauncher com.heroicgameslauncher.hgl org.vinegarhq.Sober}"

# ---------------------------------------------------------------------------
# apt behaviour inside the chroot (never interactive)
# ---------------------------------------------------------------------------
: "${APT_OPTS:=-y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o Acquire::Retries=3}"
: "${APT_MIRROR:=}"                    # optional: rewrite archive.ubuntu.com → this mirror host in the chroot
: "${DEBIAN_FRONTEND:=noninteractive}"

# ---------------------------------------------------------------------------
# QEMU test defaults (build/test-qemu.sh)
# ---------------------------------------------------------------------------
: "${QEMU_RAM_MB:=4096}"
: "${QEMU_CPUS:=4}"
: "${QEMU_DISK_GB:=30}"
: "${OVMF_CODE:=/usr/share/OVMF/OVMF_CODE_4M.fd}"
: "${OVMF_VARS:=/usr/share/OVMF/OVMF_VARS_4M.fd}"

# ---------------------------------------------------------------------------
# Docker (build/docker-build.sh)
# ---------------------------------------------------------------------------
: "${DOCKER_IMAGE:=lindos-builder:latest}"

export LINDOS_VERSION LINDOS_CODENAME LINDOS_MAINTAINER LINDOS_HOME_URL
export MINT_VERSION MINT_CODENAME BASE_UBUNTU_CODENAME BASE_ISO_URL BASE_ISO_SHA256 BASE_ISO_FILE
export OUT_DIR WORK_DIR CACHE_DIR DEBS_DIR ASSETS_DIR ISO_NAME BUILD_LOG
export SQUASHFS_COMP SQUASHFS_ARGS ISO_VOLID ISO_PUBLISHER ISO_APPID DISK_INFO MIN_FREE_GB ISO_METHOD
export KEEP_ISO_MODDATE SYNC_CASPER_KERNEL LINDOS_PASSTHRU_VARS
export INCLUDE_WINE INCLUDE_STEAM INCLUDE_FLATPAK_LAUNCHERS KISAK_MESA ADD_WINEHQ_REPO ADD_STEAM_REPO
export ADD_FLATHUB ADD_MOZILLA_REPO ENABLE_I386 DEBLOAT_PURGE DEBLOAT_DISABLE_SERVICES EXTRA_PACKAGES
export LINDOS_DEB_ORDER INSTALL_MODE_PACKAGES PLYMOUTH_THEME TUNE_MODE GAMING_ITEMS FLATPAK_LAUNCHERS
export APT_OPTS APT_MIRROR DEBIAN_FRONTEND
export QEMU_RAM_MB QEMU_CPUS QEMU_DISK_GB OVMF_CODE OVMF_VARS DOCKER_IMAGE
