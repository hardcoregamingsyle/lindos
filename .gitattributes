# Lindos — line-ending and binary rules.
# Everything text is normalised to LF; shell scripts and DEBIAN maintainer
# scripts MUST never carry CRLF (they run on Linux inside the chroot/ISO).
* text=auto eol=lf

# Explicit text types (belt and braces)
*.sh       text eol=lf
*.py       text eol=lf
*.env      text eol=lf
*.cfg      text eol=lf
*.conf     text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
*.md       text eol=lf
*.desktop  text eol=lf
*.policy   text eol=lf
*.rules    text eol=lf
*.service  text eol=lf
*.preset   text eol=lf
*.list     text eol=lf
*.sources  text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.css      text eol=lf
*.svg      text eol=lf
Makefile   text eol=lf
Dockerfile text eol=lf

# Binaries
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.iso   binary
*.img   binary
*.deb   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.tar   binary
*.tar.* binary
*.bz2   binary
*.gz    binary
*.xz    binary
*.zst   binary
*.squashfs binary
*.qcow2 binary
