[Unit]
Description=Lindos: silent retry of the driver install (installed system only)
Documentation=man:lindos-drivers(1)
# The INSTALLER installs drivers while installing and records the result in
# /var/lib/lindos/install-state.json (step 'drivers').  This oneshot is only the SILENT background
# retry for what the installer could not do (offline install, timeout, failure): driver-firstboot.sh
# reads install-state first - 'done'/'skipped' -> it writes the marker and exits at once;
# 'pending'/'failed'/unknown -> while online it retries without any window or wizard.  A retry never
# goes beyond the installer's own consent (SPEC-VM.md section 24): free drivers only, unless the
# installer recorded the user's consent for proprietary ones - and never an NVIDIA DKMS driver with
# Secure Boot on.  Never runs inside containers/chroots.
# Must never run in the live/ISO session either (same guard as lindos-browser-firstboot.service):
# ConditionKernelCommandLine refuses to start while 'boot=casper' (or 'boot=live') is on the kernel
# command line (casper is Mint/Ubuntu's live-session bootstrap — present only when booted straight
# off the ISO, never on an installed system). Without this, a boot-test/live-USB session would
# retry a driver install on every single boot, since it never gets the chance to persist the marker
# to a real, writable /var/lib.
# It must not run before the new user has finished Ubiquity's oem-config first-boot wizard either:
# while that is armed, /lib/systemd/system/oem-config.target exists (oem-config-firstboot deletes it
# as its very last step, right before it isolates graphical.target).
# NetworkManager-wait-online is masked on Lindos, so network-online.target is reached before
# Wi-Fi/DHCP is up: the script waits for NetworkManager itself (wait-for-network, bounded).
# Ordered AFTER the Chrome retry (lindos-browser-firstboot.service): both are queued in the same
# transaction the moment oem-config finishes and both end up in apt, which does not queue by itself
# (a second apt-get fails with "Could not get lock /var/lib/dpkg/lock-frontend", and a lost driver
# attempt is counted against its three tries).  If that unit is not queued (already done, or
# lindos-core alone) the ordering is a no-op.  The script additionally takes its turn behind every other
# Lindos apt job and waits for a dpkg lock somebody else holds (apt-serialise of lindos-core), so a
# retry started by hand or by Settings meanwhile is safe too.
ConditionKernelCommandLine=!boot=casper
ConditionKernelCommandLine=!boot=live
ConditionPathExists=!/lib/systemd/system/oem-config.target
ConditionPathExists=!/var/lib/lindos/driver-firstboot.done
ConditionVirtualization=!container
Wants=network-online.target
After=network-online.target lindos-browser-firstboot.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/lindos/driver-firstboot.sh
# Best effort: a driver retry must never block or fail the boot (the script itself stops a retry
# after 15 minutes, once it has had its turn - up to 3 more minutes of queueing behind another apt
# job; this is the outer safety net).  The clock starts when the unit starts, after the Chrome retry.
TimeoutStartSec=1500
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
