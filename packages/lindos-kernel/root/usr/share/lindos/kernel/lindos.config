# lindos.config — Lindos kernel config fragment (SPEC-KERNEL §15.2), single source of truth.
#
# This is a *fragment*, not a full kernel config.  build/kernel/build-kernel.sh runs
# `make defconfig`, then `scripts/kconfig/merge_config.sh -m .config lindos.config`, then
# `make olddefconfig`, so any symbol not named here keeps its defconfig value.
#
# Rules enforced by lindos_kernel.kconfig: only `CONFIG_*=y|m|n` and `# comment` lines,
# no duplicate keys, and no key set to two different values.  The unit test asserts every
# required key below is present.

# --- Wine / Proton fast paths ------------------------------------------------------------
# In-kernel NT synchronisation primitives (/dev/ntsync) — replaces esync/fsync.
CONFIG_NTSYNC=y
# Robust futexes and FUTEX2/WAIT_MULTIPLE are what fsync fell back to; keep them on.
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y

# --- sched_ext (pluggable BPF schedulers: scx_lavd, scx_bpfland, ...) ---------------------
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_DEBUG_INFO_BTF=y

# --- latency: 1000 Hz tick + full preemption ---------------------------------------------
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# --- memory: MGLRU, zram, zswap, THP -----------------------------------------------------
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# --- networking: BBR + fair queueing -----------------------------------------------------
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_DEFAULT_BBR=y

# --- block I/O schedulers (BFQ for desktop responsiveness, Kyber for NVMe) ----------------
CONFIG_IOSCHED_BFQ=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_BLK_WBT=y

# --- CPU frequency: amd_pstate (EPP) -----------------------------------------------------
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# --- containers / sandboxing (Proton, Flatpak, Steam) ------------------------------------
CONFIG_USER_NS=y
CONFIG_CHECKPOINT_RESTORE=y

# --- misc quality-of-life ----------------------------------------------------------------
CONFIG_TASK_DELAY_ACCT=y
CONFIG_PSI=y
