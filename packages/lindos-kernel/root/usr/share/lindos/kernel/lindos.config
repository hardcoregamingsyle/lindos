# lindos.config — Lindos kernel config fragment (SPEC-KERNEL §15.2), single source of truth.
#
# This is a *fragment*, not a full kernel config.  build/kernel/build-kernel.sh runs
# `make defconfig`, then `scripts/kconfig/merge_config.sh -m .config lindos.config`, then
# `make olddefconfig`, so any symbol not named here keeps its defconfig value.
#
# Rules enforced by lindos_kernel.kconfig: only `CONFIG_*=y|m|n` and `# comment` lines,
# no duplicate keys, and no key set to two different values.  The unit test asserts every
# required key below is present.

# --- Wine / Proton fast paths ------------------------------------------------------------
# In-kernel NT synchronisation primitives (/dev/ntsync) — replaces esync/fsync.
CONFIG_NTSYNC=y
# Robust futexes and FUTEX2/WAIT_MULTIPLE are what fsync fell back to; keep them on.
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y

# --- sched_ext (pluggable BPF schedulers: scx_lavd, scx_bpfland, ...) ---------------------
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_DEBUG_INFO_BTF=y

# --- latency: 1000 Hz tick + full preemption ---------------------------------------------
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# --- memory: MGLRU, zram, zswap, THP -----------------------------------------------------
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# --- networking: BBR + fair queueing -----------------------------------------------------
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_DEFAULT_BBR=y

# --- block I/O schedulers (BFQ for desktop responsiveness, Kyber for NVMe) ----------------
CONFIG_IOSCHED_BFQ=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_BLK_WBT=y

# --- CPU frequency: amd_pstate (EPP) -----------------------------------------------------
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# --- containers / sandboxing (Proton, Flatpak, Steam) ------------------------------------
CONFIG_USER_NS=y
CONFIG_CHECKPOINT_RESTORE=y

# --- misc quality-of-life ----------------------------------------------------------------
CONFIG_TASK_DELAY_ACCT=y
CONFIG_PSI=y

# --- Addendum W (SPEC-WINDOWS §31.1): Windows-format + transfer/play-anywhere plumbing -----
# NTFS3: read/write NTFS, including CompactOS/WOF-compressed files (LZX/XPRESS) and POSIX ACLs.
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
# exFAT (USB drives / SD cards formatted by Windows).
CONFIG_EXFAT_FS=m
# ext4 casefold (case-insensitive C:\ drives for Wine prefixes) needs kernel Unicode support.
CONFIG_UNICODE=y
# .exe/.msi run directly from a terminal path (binfmt_misc -> lindos-binfmt -> lindos-run).
CONFIG_BINFMT_MISC=y
# UEFI variable access (Secure Boot state, BootNext for "restart into Windows").
CONFIG_EFIVAR_FS=y
# BitLocker (cryptsetup --type bitlk) needs dm-crypt and the userspace skcipher API.
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
# Loop devices + ISO9660/Joliet/UDF for mounting Windows setup/recovery ISOs read-only.
CONFIG_BLK_DEV_LOOP=y
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_UDF_FS=m
# FUSE (ntfs-3g fallback / dislocker).
CONFIG_FUSE_FS=y
# Windows dynamic disks (LDM, MBR) so Easy Transfer can read them read-only.
CONFIG_LDM_PARTITION=y

# --- Display / GPU (CONTINUATION.md item 2, boot-test run 36319809802): a laptop (or CI's
# QEMU) with no working KMS/DRM driver never draws a frame -- LightDM waits on seat0's
# CanGraphical, which needs a GPU driver to have registered a DRM device, so a kernel missing
# these would hang graphical.target forever on REAL hardware too, not just in a VM. --base-config
# ubuntu (the default -- see build/kernel/lib/base-config.sh) already carries Ubuntu's own
# generic-flavour values for all of these, so in practice this section only guards against a
# regression (a future base-config change, or --base-config defconfig's "fast CI smoke build"
# path, silently dropping one) -- it is not, by itself, evidence of what caused any one boot-test
# hang. Required unconditionally so `make defconfig`-based builds get real display support too.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# SYSFB_SIMPLEFB + DRM_SIMPLEDRM: turns a firmware-provided framebuffer (UEFI GOP on a real
# laptop, or QEMU/SeaBIOS VESA/Bochs-VBE mode) into an early, driver-independent DRM/KMS device,
# so there is *something* for LightDM/Xorg to see even before/without the real GPU driver below.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
# Real-laptop GPU drivers (SPEC-KERNEL, this task's step 1): Intel iGPU (i915 covers everything
# up to ~Tiger/Alder/Raptor Lake; xe is the newer driver for Meteor Lake/Arc/Battlemage+ -- both
# coexist so either generation of Intel hardware gets a working driver), AMD iGPU/dGPU (amdgpu
# covers all GCN+ hardware; radeon is the older pre-GCN driver, kept for older laptops), Nvidia
# (nouveau; the proprietary driver is not redistributable/buildable in-tree). Confirmed present
# with these exact values in the actual built 6.14.0-lindos config (CI run 36319809802,
# extracted from the linux-image .deb) -- Ubuntu's generic base config already carries all of
# this; these lines are a regression guard, not evidence of what caused that run's boot hang.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
# QEMU/CI-only virtual GPUs: bochs (the "-vga std" VBE-compatible framebuffer this boot-test
# harness used originally), virtio-gpu (build/qa/boot_test.py's current default -- see
# build_qemu_argv()), and qxl (spice), so the boot-test VM (and anyone using virt-manager/
# VirtualBox-style tooling) also gets a real KMS device regardless of which virtual display the
# hypervisor exposes.
CONFIG_DRM_BOCHS=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_QXL=m
