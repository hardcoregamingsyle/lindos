Icon=lindos-winapp
Terminal=true
NoDisplay=false
StartupNotify=false
Categories=System;Utility;X-Lindos;X-WinApps;
Keywords=Windows;RDP;RemoteApp;WinApps;Adobe;Office;Photoshop;
X-Lindos-Component=winapps
