#!/bin/sh
# preinst for lindos-desktop -- divert the distribution's XFCE/LightDM defaults so that
# the Lindos versions of the same files can be unpacked without dpkg file conflicts
# (Mint's mint-artwork / xfce4-settings / slick-greeter ship some of these paths).
# Diverted originals get the suffix ".lindos-orig" (never "*.xml"/"*.conf"/"*.desktop",
# so xfconfd, fontconfig, lightdm and the autostart parser ignore them).  Idempotent;
# postrm removes the diversions again.
set -e

PKG=lindos-desktop

DIVERT_FILES="
/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml
/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml
/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml
/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/thunar.xml
/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-notifyd.xml
/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml
/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml
/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/keyboards.xml
/etc/xdg/xfce4/panel/whiskermenu-1.rc
/etc/xdg/xfce4/panel/docklike-2.rc
/etc/xdg/gtk-3.0/settings.ini
/etc/lightdm/slick-greeter.conf
"

case "${1:-}" in
    install|upgrade)
        if command -v dpkg-divert >/dev/null 2>&1; then
            for f in $DIVERT_FILES; do
                # only add when not already diverted by us (dpkg-divert --add is idempotent
                # for identical diversions, but be explicit and quiet)
                if ! dpkg-divert --list "$f" 2>/dev/null | grep -q "by $PKG\$"; then
                    dpkg-divert --package "$PKG" --add --rename --quiet \
                        --divert "$f.lindos-orig" "$f" || true
                fi
            done
        fi
        ;;
    abort-upgrade)
        ;;
    *)
        ;;
esac

exit 0
