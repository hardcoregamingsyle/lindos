#!/bin/sh
# postinst for lindos-desktop -- idempotent, offline (never downloads anything)
set -e

log() { printf 'lindos-desktop: %s\n' "$*"; }

PLYMOUTH_DIR=/usr/share/plymouth/themes/lindos

case "${1:-}" in
    configure)
        # 1. helper scripts must be executable even if the builder missed them
        for f in /usr/bin/lindos-compositor \
                 /usr/libexec/lindos/apply-branding.sh \
                 /usr/libexec/lindos/build-panel-profiles.sh \
                 /usr/libexec/lindos/first-login-panel.sh \
                 /usr/libexec/lindos/live-session-power.sh \
                 /usr/libexec/lindos/merge-mimeapps.py \
                 /usr/libexec/lindos/panel-profile-pack.py \
                 /usr/libexec/lindos/plymouth-gen-assets.py \
                 /usr/libexec/lindos/rebrand-base.py \
                 /usr/libexec/lindos/taskbar-fallback.py; do
            if [ -f "$f" ] && [ ! -x "$f" ]; then
                chmod 0755 "$f"
            fi
        done

        # 2. icon caches (hicolor gets lindos-start / lindos-logo / lindos-settings ...)
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            for d in /usr/share/icons/hicolor /usr/share/icons/Lindos /usr/share/icons/Lindos-dark; do
                if [ -d "$d" ] && [ -f "$d/index.theme" ]; then
                    gtk-update-icon-cache -q -t -f "$d" 2>/dev/null || log "gtk-update-icon-cache $d failed (ignored)"
                fi
            done
        fi
        if command -v update-icon-caches >/dev/null 2>&1; then
            update-icon-caches /usr/share/icons/hicolor 2>/dev/null || true
        fi

        # 3. font configuration (60-lindos-ui.conf aliases Segoe UI -> Selawik)
        if command -v fc-cache >/dev/null 2>&1; then
            fc-cache -f -s >/dev/null 2>&1 || log "fc-cache failed (ignored)"
        fi

        # 4. Plymouth: the theme is script-based; its PNG assets (spinner dot, bar pixels)
        #    are generated with pure python3 and the logo is rendered from logo.svg with
        #    rsvg-convert when librsvg2-bin is present.  Without them the script falls back
        #    to text primitives (documented in lindos.script) -- nothing is downloaded.
        if [ -d "$PLYMOUTH_DIR" ] && command -v python3 >/dev/null 2>&1 && [ -f /usr/libexec/lindos/plymouth-gen-assets.py ]; then
            python3 /usr/libexec/lindos/plymouth-gen-assets.py --quiet --theme-dir "$PLYMOUTH_DIR" \
                || log "plymouth-gen-assets.py failed (ignored; text fallback)"
        elif [ -f "$PLYMOUTH_DIR/logo.svg" ] && [ ! -f "$PLYMOUTH_DIR/logo.png" ] && command -v rsvg-convert >/dev/null 2>&1; then
            rsvg-convert -w 192 -h 192 -o "$PLYMOUTH_DIR/logo.png" "$PLYMOUTH_DIR/logo.svg" 2>/dev/null \
                || { rm -f "$PLYMOUTH_DIR/logo.png"; log "rsvg-convert failed; Plymouth uses text-only fallback"; }
        fi

        # 5. branding: /etc/os-release fragment, /etc/issue, Plymouth default theme,
        #    default-wallpaper alternative and the Mint sweep (hides the Mint Welcome/Software
        #    Manager duplicates, lsb-release/linuxmint-info display fields, Firefox start page);
        #    all idempotent, all guarded.  /etc/apt/apt.conf.d/99lindos-branding runs the same
        #    script (--files-only) after every later apt run.
        if [ -x /usr/libexec/lindos/apply-branding.sh ]; then
            /usr/libexec/lindos/apply-branding.sh --quiet || log "apply-branding.sh reported a problem (ignored)"
        fi

        # 5a. Lindos's own /etc/xdg/xdg-xfce (see the preinst): a leftover symlink into mint-artwork goes aside,
        #     then the directory is created here - it is not a packaged path.  LINDOS_ROOT: test seam.
        XDG_XFCE="${LINDOS_ROOT:-}/etc/xdg/xdg-xfce"
        if [ -L "$XDG_XFCE" ]; then
            case "$(readlink -f "$XDG_XFCE" 2>/dev/null)" in
                *mint-artwork*)
                    rm -f "$XDG_XFCE.lindos-orig"
                    mv "$XDG_XFCE" "$XDG_XFCE.lindos-orig" || true
                    ;;
            esac
        fi
        if [ ! -e "$XDG_XFCE" ] && [ ! -L "$XDG_XFCE" ]; then
            mkdir -p "$XDG_XFCE" 2>/dev/null || true
        fi
        if [ -d "$XDG_XFCE" ] && [ ! -L "$XDG_XFCE" ] && [ ! -e "$XDG_XFCE/README" ]; then
            cp "${LINDOS_ROOT:-}/usr/share/lindos/xdg-xfce-README" "$XDG_XFCE/README" 2>/dev/null || true
        fi

        # 5b. the boot-menu drop-in was renamed 49-... -> 60-... (it must sort after Mint's 50_linuxmint.cfg
        #     to win); the old conffile is dropped here, the new one takes effect at the next update-grub
        rm -f "${LINDOS_ROOT:-}/etc/default/grub.d/49-lindos-distributor.cfg"

        # 5c. default applications (Mousepad, Ristretto, Evince, VLC) into /etc/xdg/mimeapps.list; only adds,
        #     never replaces a default somebody else already set
        if [ -x /usr/libexec/lindos/merge-mimeapps.py ] && command -v python3 >/dev/null 2>&1; then
            python3 /usr/libexec/lindos/merge-mimeapps.py \
                || log "merge-mimeapps.py reported a problem (ignored)"
        fi

        # 6. desktop database for the launcher shims
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications 2>/dev/null || true
        fi

        # 7. mode panel profiles: generate panel.tar.bz2 for every mode from panel/
        #    (pure python3, works offline; the ISO build hook 40-theme.sh calls it too)
        if [ -x /usr/libexec/lindos/build-panel-profiles.sh ]; then
            /usr/libexec/lindos/build-panel-profiles.sh --quiet || log "build-panel-profiles.sh failed (ignored; panel/ dir fallback stays usable)"
        fi

        # 8. Make sure this system actually boots to a graphical login. A boot-test CI run
        #    (36300817476) found a built ISO whose live session sat at a bare text VT forever:
        #    `systemctl is-system-running` reported "running" with zero failed units, yet
        #    lightdm.service stayed "inactive (dead)" with not one log line ever written for
        #    it -- consistent with graphical.target simply never being the active target, so
        #    nothing ever pulled display-manager.service in, regardless of whether lightdm
        #    itself was correctly enabled. lindos-desktop is the package responsible for the
        #    desktop experience, so make this explicit here instead of depending on whatever
        #    order the base image's other packages happened to configure themselves in. Both
        #    calls are pure symlink bookkeeping (no --now, no bus/PID1 contact needed), so they
        #    are safe and idempotent offline in the ISO build chroot and on a real install alike.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl set-default graphical.target >/dev/null 2>&1 \
                || log "systemctl set-default graphical.target failed (ignored)"
            systemctl enable lightdm.service >/dev/null 2>&1 \
                || log "systemctl enable lightdm.service failed (ignored)"
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

exit 0
