// lindos.script — Plymouth "script" plugin theme for Lindos (SPEC §2/§5).
//
// Look: #202020 background, Lindos logo (logo.png, rendered from logo.svg by the postinst
// with rsvg-convert), a Windows-style ring of spinning dots under it, a thin accent
// progress bar and status/password prompts at the bottom.
//
// Assets are optional on purpose: dot.png / bar-bg.png / bar-fg.png are generated by
// /usr/libexec/lindos/plymouth-gen-assets.py (pure python) and logo.png by rsvg-convert;
// when any of them is missing the script draws with Image.Text primitives instead
// (block glyphs for bars/dots, the word "Lindos" for the logo), so the theme always boots.

// ---------------------------------------------------------------------- palette
bg.r = 0.125; bg.g = 0.125; bg.b = 0.125;              // #202020
accent.r = 0.376; accent.g = 0.804; accent.b = 1.0;    // #60CDFF
dim.r = 0.25; dim.g = 0.25; dim.b = 0.25;              // #404040
fg.r = 0.96; fg.g = 0.96; fg.b = 0.96;

Window.SetBackgroundTopColor(bg.r, bg.g, bg.b);
Window.SetBackgroundBottomColor(bg.r, bg.g, bg.b);

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();
screen.cx = Window.GetX() + screen.w / 2;
screen.cy = Window.GetY() + screen.h / 2;

// scale factor relative to a 1080p canvas so the splash looks the same on 4K / 720p
scale = screen.h / 1080;
if (scale < 0.6) scale = 0.6;
if (scale > 2.5) scale = 2.5;

// ---------------------------------------------------------------------- helpers
// solid rectangle: prefer the generated PNGs, else a scaled block glyph
fun make_rect(w, h, which) {
    if (which == "accent") img = Image("bar-fg.png");
    else img = Image("bar-bg.png");
    if (!img) {
        if (which == "accent") img = Image.Text("█", accent.r, accent.g, accent.b);
        else img = Image.Text("█", dim.r, dim.g, dim.b);
    }
    if (!img) return img;
    return img.Scale(w, h);
}

fun make_dot(size) {
    img = Image("dot.png");
    if (img) return img.Scale(size, size);
    img = Image.Text("●", accent.r, accent.g, accent.b);
    if (img) return img.Scale(size, size);
    return make_rect(size, size, "accent");
}

// ---------------------------------------------------------------------- logo
logo.image = Image("logo.png");
if (logo.image) {
    logo.size = Math.Int(160 * scale);
    logo.image = logo.image.Scale(logo.size, logo.size);
} else {
    logo.image = Image.Text("Lindos", fg.r, fg.g, fg.b, 1, "Sans " + Math.Int(52 * scale));
    logo.size = logo.image.GetHeight();
}
logo.sprite = Sprite(logo.image);
logo.x = screen.cx - logo.image.GetWidth() / 2;
logo.y = screen.cy - logo.image.GetHeight() / 2 - Math.Int(70 * scale);
logo.sprite.SetPosition(logo.x, logo.y, 10);

// wordmark under the logo (only when the real logo image is used)
if (Image("logo.png")) {
    word.image = Image.Text("Lindos", fg.r, fg.g, fg.b, 1, "Sans " + Math.Int(22 * scale));
    word.sprite = Sprite(word.image);
    word.sprite.SetPosition(screen.cx - word.image.GetWidth() / 2,
                            logo.y + logo.image.GetHeight() + Math.Int(18 * scale), 10);
}

// ---------------------------------------------------------------------- spinner (ring of dots)
spinner.count = 6;
spinner.radius = Math.Int(22 * scale);
spinner.dot = Math.Int(9 * scale);
spinner.cx = screen.cx;
spinner.cy = logo.y + logo.image.GetHeight() + Math.Int(85 * scale);
spinner.angle = 0;
spinner.speed = 0.09;
spinner.visible = 1;
for (i = 0; i < spinner.count; i++) {
    spinner.dots[i].image = make_dot(spinner.dot);
    spinner.dots[i].sprite = Sprite(spinner.dots[i].image);
    spinner.dots[i].sprite.SetOpacity(1 - i / (spinner.count + 1));
}

fun place_spinner() {
    for (i = 0; i < spinner.count; i++) {
        a = spinner.angle - i * 0.45;
        x = spinner.cx + spinner.radius * Math.Cos(a) - spinner.dot / 2;
        y = spinner.cy + spinner.radius * Math.Sin(a) - spinner.dot / 2;
        spinner.dots[i].sprite.SetPosition(x, y, 12);
    }
}
place_spinner();

// ---------------------------------------------------------------------- progress bar
bar.w = Math.Int(320 * scale);
bar.h = Math.Int(4 * scale);
if (bar.h < 2) bar.h = 2;
bar.x = screen.cx - bar.w / 2;
bar.y = Window.GetY() + screen.h - Math.Int(150 * scale);
bar.bg = Sprite(make_rect(bar.w, bar.h, "dim"));
bar.bg.SetPosition(bar.x, bar.y, 5);
bar.bg.SetOpacity(0.9);
bar.fg = Sprite();
bar.progress = 0;

fun set_progress(p) {
    if (p < 0) p = 0;
    if (p > 1) p = 1;
    bar.progress = p;
    w = Math.Int(bar.w * p);
    if (w < 1) w = 1;
    bar.fg.SetImage(make_rect(w, bar.h, "accent"));
    bar.fg.SetPosition(bar.x, bar.y, 6);
}
set_progress(0);

fun boot_progress_cb(duration, progress) {
    set_progress(progress);
}
Plymouth.SetBootProgressFunction(boot_progress_cb);

// ---------------------------------------------------------------------- refresh (animation)
fun refresh_cb() {
    if (spinner.visible) {
        spinner.angle += spinner.speed;
        if (spinner.angle > 6.2832) spinner.angle -= 6.2832;
        place_spinner();
    }
}
Plymouth.SetRefreshFunction(refresh_cb);

// ---------------------------------------------------------------------- messages / status
message.sprite = Sprite();
message.y = Window.GetY() + screen.h - Math.Int(110 * scale);

fun show_message(text) {
    if (!text || text == "") {
        message.sprite.SetOpacity(0);
        return;
    }
    img = Image.Text(text, fg.r, fg.g, fg.b, 1, "Sans " + Math.Int(13 * scale));
    message.sprite.SetImage(img);
    message.sprite.SetPosition(screen.cx - img.GetWidth() / 2, message.y, 20);
    message.sprite.SetOpacity(1);
}

fun message_cb(text) { show_message(text); }
Plymouth.SetMessageFunction(message_cb);
Plymouth.SetDisplayMessageFunction(message_cb);

fun hide_message_cb(text) { show_message(""); }
Plymouth.SetHideMessageFunction(hide_message_cb);

fun update_status_cb(status) {
    // systemd sends "fsck:<device>:<progress>" style statuses; keep quiet otherwise
    if (status.SubString(0, 5) == "fsck:") {
        show_message("Checking disk…");
    }
}
Plymouth.SetUpdateStatusFunction(update_status_cb);

// ---------------------------------------------------------------------- prompts (LUKS / questions)
prompt.sprite = Sprite();
prompt.entry = Sprite();
prompt.box = Sprite();
prompt.y = spinner.cy + Math.Int(50 * scale);

fun hide_prompt() {
    prompt.sprite.SetOpacity(0);
    prompt.entry.SetOpacity(0);
    prompt.box.SetOpacity(0);
    spinner.visible = 1;
    for (i = 0; i < spinner.count; i++) spinner.dots[i].sprite.SetOpacity(1 - i / (spinner.count + 1));
}

fun show_prompt(text, entry_text) {
    // hide the spinner while asking for input (like the Windows sign-in card)
    spinner.visible = 0;
    for (i = 0; i < spinner.count; i++) spinner.dots[i].sprite.SetOpacity(0);
    if (!text || text == "") text = "Password";
    label = Image.Text(text, fg.r, fg.g, fg.b, 1, "Sans " + Math.Int(14 * scale));
    prompt.sprite.SetImage(label);
    prompt.sprite.SetPosition(screen.cx - label.GetWidth() / 2, prompt.y, 20);
    prompt.sprite.SetOpacity(1);
    box.w = Math.Int(320 * scale);
    box.h = Math.Int(36 * scale);
    box.x = screen.cx - box.w / 2;
    box.y = prompt.y + label.GetHeight() + Math.Int(10 * scale);
    prompt.box.SetImage(make_rect(box.w, box.h, "dim"));
    prompt.box.SetPosition(box.x, box.y, 20);
    prompt.box.SetOpacity(1);
    if (entry_text == "") entry_text = " ";
    entry = Image.Text(entry_text, fg.r, fg.g, fg.b, 1, "Sans " + Math.Int(14 * scale));
    prompt.entry.SetImage(entry);
    prompt.entry.SetPosition(box.x + Math.Int(10 * scale), box.y + (box.h - entry.GetHeight()) / 2, 21);
    prompt.entry.SetOpacity(1);
    // accent underline of the entry (WinUI text box)
    prompt.line = Sprite(make_rect(box.w, Math.Int(2 * scale) + 1, "accent"));
    prompt.line.SetPosition(box.x, box.y + box.h - 2, 22);
}

fun display_password_cb(prompt_text, bullets) {
    dots = "";
    for (i = 0; i < bullets; i++) dots += "● ";
    show_prompt(prompt_text, dots);
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_question_cb(prompt_text, entry_text) {
    show_prompt(prompt_text, entry_text);
}
Plymouth.SetDisplayQuestionFunction(display_question_cb);

fun display_normal_cb() {
    hide_prompt();
    if (prompt.line) prompt.line.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);

fun quit_cb() {
    // fade everything out for a smooth hand-over to LightDM
    show_message("");
}
Plymouth.SetQuitFunction(quit_cb);
