# Lindos default applications: the apps that replace Mint's xed / xviewer / pix / xreader / celluloid.
# Merged into /etc/xdg/mimeapps.list by lindos-desktop's postinst (/usr/libexec/lindos/merge-mimeapps.py): a default
# the administrator (or lindos-compat / Lindos Setup) already set is never replaced, users can change every entry in
# Settings > Default apps.  /etc/xdg/mimeapps.list outranks the base's /usr/share/applications/mimeapps.list, which
# Mint's mint-adjust rewrites at every boot.  Each value lists the current desktop id first and the older one after
# it: the first installed app wins.
#   text editor  Mousepad   image viewer  Ristretto   PDF / documents  Evince   audio and video  VLC
[Default Applications]
text/plain=org.xfce.mousepad.desktop;mousepad.desktop;
text/markdown=org.xfce.mousepad.desktop;mousepad.desktop;
text/x-markdown=org.xfce.mousepad.desktop;mousepad.desktop;
text/x-log=org.xfce.mousepad.desktop;mousepad.desktop;
text/x-readme=org.xfce.mousepad.desktop;mousepad.desktop;
text/x-python=org.xfce.mousepad.desktop;mousepad.desktop;
