{
  "schema": 1,
  "description": "Rules for /usr/libexec/lindos/rebrand-base.py: which parts of the base system are hidden or renamed on a Lindos system. Docs: docs/BUILDING.md, section 'Unrecognisable'.",
  "applications": {
    "dirs": ["/usr/share/applications", "/etc/skel/.local/share/applications"],
    "hide": ["mintwelcome.desktop", "mintinstall.desktop"],
    "hide_globs": [
      "mintwelcome*.desktop", "mintbackup*.desktop", "mintstick*.desktop", "mintdesktop*.desktop", "mintupgrade*.desktop",
      "lightdm-settings*.desktop", "fingwit*.desktop", "webapp-manager*.desktop", "*sticky*.desktop",
      "*warpinator*.desktop", "*hypnotix*.desktop", "thingy*.desktop", "*celluloid*.desktop",
      "xed.desktop", "xviewer.desktop", "xreader.desktop", "pix.desktop",
      "thunar*.desktop", "xfce4-terminal*.desktop", "xfce4-appfinder.desktop", "xfce4-run.desktop",
      "xfce4-file-manager.desktop", "xfce4-mail-reader.desktop", "xfce4-web-browser.desktop",
      "xfce4-about.desktop", "xfce4-dict.desktop", "xfce4-panel-profiles.desktop",
      "xfce-settings-manager.desktop", "xfce4-settings-*.desktop", "xfce-*-settings.desktop", "xfce4-*-settings.desktop",
      "xfce4-notifyd-config.desktop", "xfwm4-*.desktop", "xfdesktop-settings.desktop", "exo-*.desktop",
      "ccsm.desktop", "menulibre*.desktop"
    ],
    "hide_if_exec_matches": ["linuxmint\\.com", "\\bmintchat\\b", "webapp-manager", "mint-meta-codecs"],
    "rename": {
      "Update Manager": "Lindos Updates",
      "Driver Manager": "Lindos Drivers",
      "Software Sources": "Lindos Update Sources",
      "System Reports": "Lindos System Reports",
      "Languages": "Language and Region"
    },
    "icons": {
      "mintupdate": "lindos-update",
      "mintsources": "lindos-update",
      "mintdrivers": "lindos-drivers",
      "mintinstall": "lindos-store",
      "mintreport": "lindos-settings",
      "mintlocale": "lindos-settings"
    },
    "icon_fallback": "lindos-settings",
    "set": {},
    "skip_prefixes": ["lindos-", "ubiquity"]
  },
  "autostart": {
    "dirs": ["/etc/xdg/autostart"],
    "hide": ["mintwelcome.desktop"],
    "hide_globs": ["mintwelcome*.desktop", "*warpinator*.desktop", "*sticky*.desktop"],
    "hide_if_exec_matches": ["mintwelcome", "linuxmint\\.com", "warpinator", "\\bsticky\\b"],
    "skip_prefixes": ["lindos-"]
  },
  "files": [
    {"path": "/etc/lsb-release", "set": {"DISTRIB_DESCRIPTION": "{description}"}},
    {"path": "/etc/linuxmint/info", "set": {"DESCRIPTION": "{description}", "GRUB_TITLE": "{title}"}},
    {"path": "/etc/casper.conf", "set": {"FLAVOUR": "{name}", "USERNAME": "liveuser", "HOST": "lindos"}}
  ],
  "firefox": {
    "dirs": ["/usr/lib/firefox", "/usr/lib/firefox-esr", "/etc/firefox", "/usr/share/ubuntu-system-adjustments"],
    "homepage": "about:home"
  },
  "themes": {
    "icon_dirs": ["/usr/share/icons"],
    "hide_globs": [
      "Mint-*", "Yaru", "Yaru-*", "Papirus*", "ePapirus*", "Humanity*", "ubuntu-mono-*", "LoginIcons",
      "Bibata*", "GoogleDot*", "XCursor-Pro*", "DMZ-*"
    ]
  }
}
