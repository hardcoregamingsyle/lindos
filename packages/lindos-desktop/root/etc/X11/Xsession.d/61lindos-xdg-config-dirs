#!/bin/sh
# /etc/X11/Xsession.d/61lindos-xdg-config-dirs - sourced by /etc/X11/Xsession right after 60x11-common_xdg_path
# (which puts /etc/xdg/xdg-$DESKTOP_SESSION at the front of XDG_CONFIG_DIRS).  On the Linux Mint base that path is a
# symlink to mint-artwork's xfconf defaults, which would outrank the Lindos defaults in /etc/xdg.  lindos-desktop
# diverts the symlink; this drops any /etc/xdg/xdg-* entry that still resolves into mint-artwork (a package that
# brings it back, a failed diversion).  Sourced, not executed: no exit, no local, no IFS games, plain POSIX sh.

lindos_xdg_etc="${LINDOS_XDG_ETC:-/etc/xdg}"   # LINDOS_XDG_ETC: test seam
lindos_xdg_clean=""
lindos_xdg_rest="${XDG_CONFIG_DIRS:-}:"
while [ -n "$lindos_xdg_rest" ]; do
    lindos_xdg_dir="${lindos_xdg_rest%%:*}"
    lindos_xdg_rest="${lindos_xdg_rest#*:}"
    [ -n "$lindos_xdg_dir" ] || continue
    lindos_xdg_keep=1
    case "$lindos_xdg_dir" in
        "$lindos_xdg_etc"/xdg-*)
            lindos_xdg_target="$(readlink -f "$lindos_xdg_dir" 2>/dev/null)" || lindos_xdg_target=""
            case "$lindos_xdg_target" in
                *mint-artwork*) lindos_xdg_keep=0 ;;
            esac
            ;;
    esac
    if [ "$lindos_xdg_keep" = 1 ]; then
        lindos_xdg_clean="${lindos_xdg_clean:+$lindos_xdg_clean:}$lindos_xdg_dir"
    fi
done
if [ -z "$lindos_xdg_clean" ] && [ -n "${XDG_CONFIG_DIRS:-}" ]; then
    lindos_xdg_clean="$lindos_xdg_etc"
fi
if [ -n "$lindos_xdg_clean" ] && [ "$lindos_xdg_clean" != "${XDG_CONFIG_DIRS:-}" ]; then
    XDG_CONFIG_DIRS="$lindos_xdg_clean"
    export XDG_CONFIG_DIRS
fi
unset lindos_xdg_etc lindos_xdg_clean lindos_xdg_rest lindos_xdg_dir lindos_xdg_keep lindos_xdg_target
