[Desktop Entry]
Type=Application
Version=1.0
Name=Lindos Authentication Agent
Comment=Shows the administrator-password dialog when Lindos needs to change system settings (starts an installed polkit agent; adds no permissions)
Exec=/usr/libexec/lindos/polkit-agent-start.sh
TryExec=/usr/libexec/lindos/polkit-agent-start.sh
Icon=dialog-password
Terminal=false
NoDisplay=true
OnlyShowIn=XFCE;
X-GNOME-Autostart-Phase=Applications
X-GNOME-Autostart-Delay=1
StartupNotify=false
X-Lindos-Component=desktop
