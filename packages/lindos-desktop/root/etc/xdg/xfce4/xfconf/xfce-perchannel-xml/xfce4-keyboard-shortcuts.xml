<?xml version="1.0" encoding="UTF-8"?>

<!--
  Lindos keyboard shortcuts (SPEC section 5) - Windows-11-style bindings on top of the
  standard Xfce set.  Both "commands" (application launchers, handled by xfsettingsd)
  and "xfwm4" (window-manager actions) providers are defined.  The "custom" branch has
  override=true so it is what the desktop uses; the "default" branch is an identical
  copy so "Reset to Defaults" in xfce4-keyboard-settings restores the Lindos layout.

  Notes
  * Super_L alone opens the Start menu (xfce4-popup-whiskermenu); Super+letter combos
    keep working because xfsettingsd grabs them separately (same as Linux Mint XFCE).
  * Super+1..9 are NOT bound here: xfce4-docklike-plugin grabs them itself
    (keyComboActive=true in docklike-2.rc) to activate the N-th taskbar item.
  * Super+A: xfce4-notifyd has no "toggle notification centre" remote event, so the
    documented fallback (xfce4-notifyd-config, which contains the notification log) is used.
  * Volume/mute/brightness media keys are handled by the pulseaudio and power-manager
    panel plugins and are deliberately not bound here.
-->
<channel name="xfce4-keyboard-shortcuts" version="1.0">
  <property name="commands" type="empty">
    <property name="default" type="empty">
      <property name="Super_L" type="string" value="xfce4-popup-whiskermenu"/>
