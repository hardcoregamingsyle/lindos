<?xml version="1.0" encoding="UTF-8"?>

<!-- Lindos power defaults (Windows-like): power button = sleep, lid = sleep,
     screen off after 10 min (AC) / 5 min (battery), sleep after 30 min on battery,
     never auto-sleep on AC (desktops), lock screen on suspend, brightness keys handled.
     Values are minutes; 14 = "never" for inactivity-on-ac (slider minimum). -->
<channel name="xfce4-power-manager" version="1.0">
  <property name="xfce4-power-manager" type="empty">
    <property name="power-button-action" type="uint" value="1"/>
    <property name="sleep-button-action" type="uint" value="1"/>
    <property name="hibernate-button-action" type="uint" value="2"/>
    <property name="battery-button-action" type="uint" value="0"/>
    <property name="lid-action-on-ac" type="uint" value="1"/>
    <property name="lid-action-on-battery" type="uint" value="1"/>
    <property name="logind-handle-lid-switch" type="bool" value="false"/>
    <property name="critical-power-level" type="uint" value="8"/>
    <property name="critical-power-action" type="uint" value="1"/>
    <property name="general-notification" type="bool" value="true"/>
    <property name="show-panel-label" type="int" value="0"/>
    <property name="show-tray-icon" type="bool" value="false"/>
    <property name="presentation-mode" type="bool" value="false"/>
    <property name="lock-screen-suspend-hibernate" type="bool" value="true"/>
    <property name="dpms-enabled" type="bool" value="true"/>
    <property name="dpms-on-ac-sleep" type="uint" value="10"/>
    <property name="dpms-on-ac-off" type="uint" value="15"/>
    <property name="dpms-on-battery-sleep" type="uint" value="5"/>
    <property name="dpms-on-battery-off" type="uint" value="8"/>
    <property name="blank-on-ac" type="int" value="10"/>
    <property name="blank-on-battery" type="int" value="5"/>
    <property name="inactivity-on-ac" type="uint" value="14"/>
    <property name="inactivity-on-battery" type="uint" value="30"/>
    <property name="inactivity-sleep-mode-on-ac" type="uint" value="1"/>
    <property name="inactivity-sleep-mode-on-battery" type="uint" value="1"/>
    <property name="brightness-on-ac" type="uint" value="9"/>
    <property name="brightness-on-battery" type="uint" value="120"/>
    <property name="brightness-level-on-ac" type="uint" value="100"/>
    <property name="brightness-level-on-battery" type="uint" value="60"/>
    <property name="brightness-switch" type="int" value="0"/>
    <property name="brightness-switch-restore-on-exit" type="int" value="0"/>
    <property name="brightness-step-count" type="uint" value="10"/>
    <property name="brightness-exponential" type="bool" value="false"/>
    <property name="handle-brightness-keys" type="bool" value="true"/>
    <property name="show-brightness-popup" type="bool" value="true"/>
    <property name="heartbeat-command" type="string" value=""/>
  </property>
</channel>
