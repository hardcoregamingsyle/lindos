<?xml version="1.0" encoding="UTF-8"?>

<!-- Lindos notification daemon defaults: Windows-11-style toasts (theme "Lindos",
     /usr/share/themes/Lindos/xfce-notify-4.0/gtk.css) in the bottom-right corner,
     10 s timeout, notification log on (the log is what the panel plugin shows). -->
<channel name="xfce4-notifyd" version="1.0">
  <property name="theme" type="string" value="Lindos"/>
  <property name="notify-location" type="uint" value="3"/>
  <property name="expire-timeout" type="int" value="10"/>
  <property name="expire-timeout-enabled" type="bool" value="true"/>
  <property name="expire-timeout-allow-override" type="bool" value="true"/>
  <property name="initial-opacity" type="double" value="0.96"/>
  <property name="do-fadeout" type="bool" value="true"/>
  <property name="do-slideout" type="bool" value="true"/>
  <property name="do-not-disturb" type="bool" value="false"/>
  <property name="gauge-ignores-dnd" type="bool" value="true"/>
  <property name="show-text-with-gauge" type="bool" value="true"/>
  <property name="notification-log" type="bool" value="true"/>
  <property name="log-level" type="uint" value="0"/>
  <property name="log-level-apps" type="uint" value="0"/>
  <property name="log-max-size" type="uint" value="200"/>
  <property name="log-max-size-enabled" type="bool" value="true"/>
  <property name="primary-monitor" type="uint" value="0"/>
  <property name="date-time-format" type="string" value="%d/%m/%Y %H:%M"/>
</channel>
