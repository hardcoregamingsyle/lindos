#!/bin/sh
# postinst for lindos-vm — idempotent, offline-safe, never fails the install.
# Adds the invoking user to the libvirt/kvm groups IF those groups exist, so the
# user can talk to the system libvirt daemon and /dev/kvm without root.  It never
# creates the groups (that is libvirt-daemon-system's job) and never fails.
set -e

PYLIB="/usr/lib/lindos-vm/lindos_vm"
CLI="/usr/bin/lindos-vm"
HOOK="/etc/libvirt/hooks/qemu"

log() {
    printf 'lindos-vm: %s\n' "$*" >&2
}

# Best-effort: who invoked the install (dpkg keeps SUDO_USER/PKEXEC_UID around).
invoking_user() {
    if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
        printf '%s\n' "${SUDO_USER}"
        return 0
    fi
    if [ -n "${PKEXEC_UID:-}" ]; then
        getent passwd "${PKEXEC_UID}" 2>/dev/null | cut -d: -f1
        return 0
    fi
    return 0
}

case "${1:-}" in
    configure)
        [ -f "$CLI" ] && chmod 0755 "$CLI" 2>/dev/null || true
        [ -f "$HOOK" ] && chmod 0755 "$HOOK" 2>/dev/null || true

        # byte-compile the library (never fatal)
        if command -v py3compile >/dev/null 2>&1; then
            py3compile -p lindos-vm "$PYLIB" 2>/dev/null || true
        elif command -v python3 >/dev/null 2>&1; then
            python3 -m compileall -q "$PYLIB" 2>/dev/null || true
        fi
        if command -v python3 >/dev/null 2>&1; then
            python3 -m py_compile "$CLI" 2>/dev/null || true
        fi

        # log dir for the passthrough hook
        mkdir -p /var/log/lindos 2>/dev/null || true
        chmod 0755 /var/log/lindos 2>/dev/null || true

        # add the invoking user to libvirt/kvm groups IF present (getent-guarded)
        user="$(invoking_user 2>/dev/null || true)"
        if [ -n "${user:-}" ] && command -v usermod >/dev/null 2>&1; then
            for grp in libvirt kvm; do
                if getent group "$grp" >/dev/null 2>&1; then
                    usermod -aG "$grp" "$user" 2>/dev/null \
                        && log "added ${user} to group ${grp} (re-login to take effect)" \
                        || true
                fi
            done
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

exit 0
