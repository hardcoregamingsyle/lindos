[Desktop Entry]
Type=Application
Version=1.0
Name=Windows App Runner (Lindos)
GenericName=Windows program runner
Comment=Open Windows programs, installers, app packages, registry files, scripts and shortcuts through Wine or Proton - no virtual machine
Exec=lindos-run %f
TryExec=lindos-run
Icon=lindos-exe
Terminal=false
NoDisplay=true
StartupNotify=true
MimeType=application/x-msdownload;application/x-ms-dos-executable;application/x-dosexec;application/vnd.microsoft.portable-executable;application/x-ms-ne-executable;application/x-msi;application/x-lindos-msp;application/x-lindos-mst;application/x-ms-shortcut;application/x-bat;application/appx;application/msix;application/appxbundle;application/msixbundle;application/appinstaller;application/x-lindos-msix-upload;application/x-lindos-msix-encrypted;application/x-lindos-msixvc;text/x-ms-regedit;application/x-mswinurl;text/vbscript;text/vbscript.encode;application/x-lindos-wsf;application/x-lindos-cpl;application/x-lindos-inf;application/vnd.ms-cab-compressed;application/x-lindos-clickonce;application/x-lindos-appref-ms;application/x-lindos-dos-program;
Categories=Utility;X-Wine;X-Lindos;
Keywords=Windows;exe;msi;msix;appx;reg;Wine;Proton;program;installer;
X-Lindos-Component=compat
