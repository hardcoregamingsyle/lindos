#!/usr/bin/env python3
"""lindos-compat -- manage Windows program support on Lindos (SPEC §9).

  lindos-compat doctor [--json]
  lindos-compat prefixes list|remove|open|winecfg <slug>
  lindos-compat recipes list|show|apply <id> [--prefix SLUG]
  lindos-compat install-umu [--system]
  lindos-compat install-bottles
  lindos-compat proton list|update|remove <tag>     (delegates to lindos-proton)

Thin launcher: the logic lives in the ``lindos_compat`` package installed at
/usr/lib/lindos-compat.  Exit codes: 0 ok, 1 error, 2 usage.
"""

from __future__ import annotations

import os
import sys


def _lib_dir() -> str:
    """``/usr/bin/lindos-compat`` -> ``/usr/lib/lindos-compat`` (also valid inside the repo tree)."""
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = [
        os.path.join(os.path.dirname(here), "lib", "lindos-compat"),
        "/usr/lib/lindos-compat",
        os.environ.get("LINDOS_COMPAT_LIB", ""),
    ]
    for cand in candidates:
        if cand and os.path.isdir(os.path.join(cand, "lindos_compat")):
            return cand
    return "/usr/lib/lindos-compat"


_LIB = _lib_dir()
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

try:
    from lindos_compat.cli_compat import main  # noqa: E402
except ImportError as exc:  # pragma: no cover - broken installation
    sys.stderr.write(f"lindos-compat: cannot load lindos_compat from {_LIB}: {exc}\n"
                     "Reinstall the package: apt install --reinstall lindos-compat\n")
    sys.exit(1)

if __name__ == "__main__":
    sys.exit(main())
