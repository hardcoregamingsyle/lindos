#!/usr/bin/env python3
"""lindos-transfer-gui -- GTK wizard for lindos-transfer (SPEC-WINDOWS Addendum W, §29.12).

  lindos-transfer-gui [--from PATH] [--debug]

Thin launcher: the logic lives in the ``lindos_transfer`` package installed at
/usr/lib/lindos-transfer (resolved relative to this file, so a checkout of the
repository works too).  Exit codes: 0 ok, 1 error (no display, GTK missing, or
lindos-transfer is not installed).
"""

from __future__ import annotations

import os
import sys


def _lib_dir() -> str:
    """``/usr/bin/lindos-transfer-gui`` -> ``/usr/lib/lindos-transfer`` (also valid inside a
    checkout of the repository)."""
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = [
        os.path.join(os.path.dirname(here), "lib", "lindos-transfer"),
        "/usr/lib/lindos-transfer",
        os.environ.get("LINDOS_TRANSFER_LIB", ""),
    ]
    for cand in candidates:
        if cand and os.path.isdir(os.path.join(cand, "lindos_transfer")):
            return cand
    return "/usr/lib/lindos-transfer"


_LIB = _lib_dir()
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

try:
    from lindos_transfer.gui import main
except ImportError as exc:  # PyGObject/GTK missing, or a broken installation
    sys.stderr.write(
        f"lindos-transfer-gui: cannot start the transfer wizard: {exc}\n"
        "This needs python3-gi with GTK 3 (package gir1.2-gtk-3.0). Reinstall lindos-transfer if "
        "the problem persists: apt install --reinstall lindos-transfer\n"
        "The command-line tool still works without a display: lindos-transfer --help\n")
    sys.exit(1)

if __name__ == "__main__":
    sys.exit(main())
