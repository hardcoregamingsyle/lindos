def act_enable_earlyoom(ctx: Ctx, p: Dict[str, Any]) -> int:
    verb = "enable" if p.get("enable", True) else "disable"
    if not ctx.dry_run and not unit_exists(ctx, "earlyoom.service"):
        ctx.error("earlyoom is not installed (apt install earlyoom)")
        return EXIT_ERROR
    ok, tail = ctx.run(["systemctl", verb, "--now", "earlyoom.service"], timeout=60)
    if not ok:
        ctx.error(f"systemctl {verb} earlyoom failed: {tail}")
    return EXIT_OK if ok else EXIT_ERROR


