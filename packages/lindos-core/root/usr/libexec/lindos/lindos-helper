# --- dual-boot: "restart into Windows" / firmware setup (SPEC-WINDOWS §27, §30.3-§30.4) --------
# This is the one place that actually reboots the machine, so it re-derives and re-checks every
# fact for itself instead of trusting the (already-validated, but client-supplied) payload: the
# entry/menu id must belong to a *currently real* active Windows Boot Manager loader or
# --class windows os-prober menu entry, never merely to something the caller claims.
def act_reboot_to_windows(ctx: Ctx, p: Dict[str, Any]) -> int:
    method = p["method"]
    if method == "bootnext":
        efibootmgr = ctx.which("efibootmgr")
        if not efibootmgr and not ctx.dry_run:
            ctx.error("efibootmgr is not installed (apt install efibootmgr)")
            return EXIT_ERROR
        if ctx.dry_run:
            ctx.say(f"[dry-run] would re-run efibootmgr and require entry {p['entry']} to be "
                     "an active Windows Boot Manager loader (\\EFI\\Microsoft\\Boot\\bootmgfw.efi)")
        else:
            ok, out = _run_capture(ctx, [efibootmgr])
            if not ok:
                ctx.error(f"efibootmgr failed: {out.strip() or 'unknown error'}")
                return EXIT_ERROR
            parsed = ldualboot.parse_efibootmgr(out)
            entries = {e.num.upper(): e for e in parsed["entries"]}
            entry = entries.get(p["entry"].upper())
            if entry is None or not entry.is_windows or not entry.active:
                ctx.error(f"boot entry {p['entry']} is not currently an active Windows Boot "
                         "Manager entry — refusing (this never edits Windows or your firmware)")
                return EXIT_ERROR
        ok, tail = ctx.run([efibootmgr or "efibootmgr", "--bootnext", p["entry"]], timeout=30)
        if not ok:
            ctx.error(f"efibootmgr --bootnext {p['entry']} failed: {tail}")
            return EXIT_ERROR
    else:  # grub-reboot
        grub_reboot = ctx.which("grub-reboot") or ctx.which("grub2-reboot")
        if not grub_reboot and not ctx.dry_run:
            ctx.error("grub-reboot is not installed (apt install grub2-common)")
            return EXIT_ERROR
        if ctx.dry_run:
            ctx.say(f"[dry-run] would re-read grub.cfg and require {p['menuentry']} to be a "
                     "--class windows os-prober menu entry, and require grubenv to be writable")
        else:
            cfg_path = lpaths.resolve(GRUB_CFG_PATH)
            try:
                with open(cfg_path, "r", encoding="utf-8", errors="replace") as fh:
                    cfg_text = fh.read()
            except OSError as exc:
                ctx.error(f"cannot read {cfg_path}: {exc}")
                return EXIT_ERROR
            ids = {row["id"] for row in ldualboot.grub_windows_entries(cfg_text)}
            if p["menuentry"] not in ids:
                ctx.error(f"{p['menuentry']} is not a --class windows GRUB menu entry — refusing")
                return EXIT_ERROR
            if not ldualboot.grubenv_writable():
                ctx.error("grubenv cannot be written on this /boot (btrfs, zfs, LVM or mdraid) — "
                         "the one-shot choice would stick and every boot would go to Windows; "
                         "choose Windows from the GRUB menu by hand instead")
                return EXIT_ERROR
        ok, tail = ctx.run([grub_reboot or "grub-reboot", p["menuentry"]], timeout=30)
        if not ok:
            ctx.error(f"grub-reboot {p['menuentry']} failed: {tail}")
            return EXIT_ERROR
    if not p.get("reboot", True):
        ctx.say("one-shot boot choice set; not rebooting (reboot: false)")
        return EXIT_OK
    ok, tail = ctx.run(["systemctl", "reboot"], timeout=30)
    if not ok:
        ctx.error(f"systemctl reboot failed: {tail}")
    return EXIT_OK if ok else EXIT_ERROR


