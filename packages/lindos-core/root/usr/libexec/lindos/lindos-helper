# install-local-debs (SPEC-UPDATE.md §36.4; read-only planning lives in ``lindos.update``) --------
def act_apt_get_update(ctx: Ctx, p: Dict[str, Any]) -> int:
    """Refresh apt's package indexes only — nothing is installed/removed/upgraded here."""
    if not ctx.online() and not ctx.dry_run:
        ctx.error("offline: cannot refresh package indexes (apt-get update needs network)")
        return EXIT_ERROR
    ok, tail = ctx.run(["apt-get", "update", "-q"], timeout=900)
    if not ok:
        ctx.error(f"apt-get update failed: {tail}")
    return EXIT_OK if ok else EXIT_ERROR


def act_system_upgrade(ctx: Ctx, p: Dict[str, Any]) -> int:
    """``apt-get install --only-upgrade`` the **exact** ``name=version`` tokens already validated
    by :func:`lindos.helper.validate_payload` — never a bare ``upgrade``/``dist-upgrade``."""
    packages = list(p.get("packages", []))
    if not packages:
        ctx.say("system-upgrade: nothing to do (empty package list)")
        return EXIT_OK
    if not ctx.online() and not ctx.dry_run:
        ctx.error("offline: cannot upgrade " + " ".join(packages))
        return EXIT_ERROR
    # "--" ends option parsing: defense in depth, matching apt_install()/flatpak_install() above.
    ok, tail = ctx.run(["apt-get", "install", "--only-upgrade", "-y", "-q",
                        "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold",
                        "--"] + packages, timeout=1800)
    if not ok:
        ctx.error(f"apt-get install --only-upgrade failed: {tail}")
    return EXIT_OK if ok else EXIT_ERROR


def act_cleanup_old_packages(ctx: Ctx, p: Dict[str, Any]) -> int:
    """``apt-get autoremove --purge`` (old kernels/orphaned dependencies) — fully offline-safe."""
    ok, tail = ctx.run(["apt-get", "autoremove", "--purge", "-y", "-q"], timeout=900)
    if not ok:
        ctx.error(f"apt-get autoremove --purge failed: {tail}")
    return EXIT_OK if ok else EXIT_ERROR


def act_install_local_debs(ctx: Ctx, p: Dict[str, Any]) -> int:
    """Re-verify every file's real ``Package:`` field (never trust the filename alone — that was
    only :func:`lindos.helper.validate_payload`'s cheap client-side proxy) before ``dpkg -i``-ing
    the whole batch, then ``apt-get -f install -y`` to resolve dependencies."""
    files = list(p.get("files", []))
    if not files:
        ctx.say("install-local-debs: nothing to do (empty file list)")
        return EXIT_OK
    dpkg_deb = ctx.which("dpkg-deb")
    if not dpkg_deb and not ctx.dry_run:
        ctx.error("dpkg-deb is not installed (part of dpkg — this should never happen)")
        return EXIT_ERROR
    verified: List[str] = []
    for path in files:
        if not ctx.dry_run and not os.path.isfile(path):
            ctx.error(f"file not found: {path}")
            return EXIT_ERROR
        ok, out = _run_capture(ctx, [dpkg_deb or "dpkg-deb", "--field", path, "Package"])
        pkg_name = out.strip()
        if ctx.dry_run:
            ctx.say(f"[dry-run] would verify {path}'s Package field starts with 'lindos-' before dpkg -i")
        elif not ok or not pkg_name or not lhelper.PACKAGE_RE.match(pkg_name) or not pkg_name.startswith("lindos-"):
            ctx.error(f"{path}: Package field {pkg_name!r} is not a lindos-* package — refusing")
            return EXIT_ERROR
        else:
            ctx.say(f"verified {path}: Package: {pkg_name}")
        verified.append(path)
    ok, tail = ctx.run(["dpkg", "-i", "--"] + verified, timeout=900)
    if not ok:
        ctx.error(f"dpkg -i failed: {tail}")
    ok2, tail2 = ctx.run(["apt-get", "-f", "install", "-y", "-q"], timeout=900)
    if not ok2:
        ctx.error(f"apt-get -f install failed: {tail2}")
    return EXIT_OK if (ok and ok2) else EXIT_ERROR


