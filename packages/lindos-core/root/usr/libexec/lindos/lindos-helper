# --- Wi-Fi import (SPEC-WINDOWS §29.8, §30.4) --------------------------------------------------
def _wifi_safe_name(ssid: str) -> str:
    """A filesystem-safe, collision-proof slug for the ``.nmconnection`` filename.

    Two different SSIDs can slugify to the same ASCII text (accents/punctuation stripped), so a
    short hash of the *real* SSID bytes is always appended.
    """
    slug = lcompat.slugify(ssid, max_len=40) if ssid.strip() else "hidden-network"
    digest = hashlib.sha256(ssid.encode("utf-8", "surrogatepass")).hexdigest()[:8]
    return f"{slug}-{digest}"


def _render_nmconnection(net: Dict[str, Any]) -> str:
    """A NetworkManager keyfile for one imported network (nm-settings-keyfile(5))."""
    ssid = net["ssid"]
    security = net["security"]
    hidden = bool(net.get("hidden"))
    agent_owned = bool(net.get("agent_owned"))
    psk = net.get("psk")
    lines = [
        "[connection]",
        f"id=Lindos: {ssid}",
        f"uuid={uuid.uuid4()}",
        "type=wifi",
        "autoconnect=true",
        "",
        "[wifi]",
        "mode=infrastructure",
        f"ssid={ssid}",
    ]
    if hidden:
        lines.append("hidden=true")
    lines.append("")
    if security != "open":
        lines.append("[wifi-security]")
        lines.append("key-mgmt=" + ("wpa-psk" if security == "wpa-psk" else "sae"))
        if psk and not agent_owned:
            lines.append(f"psk={psk}")
        else:
            lines.append("psk-flags=1")   # NetworkManager asks the user once, stores it in their keyring
        lines.append("")
    lines += ["[ipv4]", "method=auto", "", "[ipv6]", "method=auto", ""]
    return "\n".join(lines).rstrip("\n") + "\n"


def act_import_wifi(ctx: Ctx, p: Dict[str, Any]) -> int:
    conn_dir = lpaths.resolve(NM_SYSTEM_CONNECTIONS_DIR)
    ok_all = True
    for net in p["networks"]:
        filename = f"lindos-{_wifi_safe_name(net['ssid'])}.nmconnection"
        path = os.path.join(conn_dir, filename)
        content = _render_nmconnection(net)
        # root:root is automatic (this process runs as root by the time we get here); 0600 is explicit.
        if not ctx.write_file(path, content, mode=0o600):
            ok_all = False
            continue
        ctx.say(f"wifi: wrote {path} (ssid: {net['ssid']!r})")
        ok, tail = ctx.run(["nmcli", "connection", "load", path], timeout=30, allow_missing=True)
        if not ok:
            ctx.warn(f"nmcli connection load {path} failed: {tail}")
    return EXIT_OK if ok_all else EXIT_ERROR


# --- terminal ./setup.exe via binfmt_misc (SPEC-WINDOWS §28.7) ---------------------------------
def act_set_binfmt(ctx: Ctx, p: Dict[str, Any]) -> int:
    mask_path = lpaths.resolve(BINFMT_MASK_PATH)
    conf_path = lpaths.resolve(BINFMT_CONF_PATH)
    if p.get("enabled"):
        if ctx.dry_run:
            ctx.say(f"[dry-run] would remove the binfmt mask {mask_path} (if present)")
        else:
            try:
                if os.path.islink(mask_path) or os.path.exists(mask_path):
                    os.remove(mask_path)
                    ctx.say(f"removed binfmt mask {mask_path}")
            except OSError as exc:
                ctx.error(f"cannot remove {mask_path}: {exc}")
                return EXIT_ERROR
        systemd_binfmt = ctx.which("systemd-binfmt") or SYSTEMD_BINFMT_BIN
        ok, tail = ctx.run([systemd_binfmt, conf_path], timeout=30)
        if not ok:
            ctx.error(f"{systemd_binfmt} {conf_path} failed: {tail}")
            return EXIT_ERROR
        ctx.say(f"binfmt: {BINFMT_NAME} enabled (a terminal './setup.exe' now runs through Lindos)")
        return EXIT_OK
    # disable: mask it for next boot, and remove the live entry now if it is registered
    if ctx.dry_run:
        ctx.say(f"[dry-run] would symlink {mask_path} -> /dev/null")
        ctx.say(f"[dry-run] would write '-1' to {BINFMT_PROC_ENTRY} (ignoring a missing entry)")
        return EXIT_OK
    try:
        os.makedirs(os.path.dirname(mask_path), exist_ok=True)
        if os.path.islink(mask_path) or os.path.exists(mask_path):
            os.remove(mask_path)
        os.symlink("/dev/null", mask_path)
        ctx.say(f"masked {conf_path} ({mask_path} -> /dev/null)")
    except OSError as exc:
        ctx.error(f"cannot mask {conf_path}: {exc}")
        return EXIT_ERROR
    proc_entry = lpaths.resolve(BINFMT_PROC_ENTRY)
    try:
        with open(proc_entry, "w", encoding="utf-8") as fh:
            fh.write("-1")
        ctx.say(f"binfmt: {BINFMT_NAME} disabled (removed the live entry)")
    except FileNotFoundError:
        ctx.say(f"binfmt: {BINFMT_NAME} was not currently registered; mask written for next boot")
    except OSError as exc:
        ctx.error(f"cannot write {proc_entry}: {exc}")
        return EXIT_ERROR
    return EXIT_OK


