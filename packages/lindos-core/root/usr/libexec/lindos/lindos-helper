def _redact_for_log(action: str, payload: Dict[str, Any]) -> Dict[str, Any]:
    """A copy of *payload* safe to print or log — a secret (``import-wifi``'s Wi-Fi passwords)
    must never reach the log file or a dry-run's echoed-back JSON, exactly as it must never reach
    argv (that is what ``stdin_payload`` is for)."""
    if action != "import-wifi":
        return payload
    redacted = dict(payload)
    redacted["networks"] = [
        {**net, "psk": ("***" if net.get("psk") else net.get("psk"))} for net in payload.get("networks", [])
    ]
    return redacted


# --- entry point --------------------------------------------------------------------------------
def _read_payload(text: Optional[str]) -> Any:
    if text is None or text == "":
        return {}
    if text == "-":
        text = sys.stdin.read()
    return json.loads(text)


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(prog=PROG, description=__doc__.split("\n\n")[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog="Actions: " + ", ".join(ACTIONS))
    parser.add_argument("action", nargs="?", help="one of the whitelisted actions")
    parser.add_argument("payload", nargs="?", help="JSON object (or '-' to read it from stdin)")
    parser.add_argument("--list", action="store_true", help="print the action whitelist and exit")
    parser.add_argument("--version", action="version", version=f"{PROG} {LINDOS_VERSION}")
    try:
        ns = parser.parse_args(argv)
    except SystemExit as exc:  # argparse uses 2 for usage errors already
        return int(exc.code or 0)

    if ns.list:
        print("\n".join(ACTIONS))
        return EXIT_OK
    if not ns.action:
        parser.print_usage(sys.stderr)
        return EXIT_USAGE

    dry_run = os.environ.get(DRYRUN_ENV, "").strip().lower() in ("1", "true", "yes", "on")
    setup_logging(dry_run)

    if ns.action not in ACTIONS:
        sys.stderr.write(f"{PROG}: unknown action '{ns.action}' (see --list)\n")
        log.error("rejected unknown action %r", ns.action)
        return EXIT_USAGE
    try:
        raw = _read_payload(ns.payload)
    except ValueError as exc:
        sys.stderr.write(f"{PROG}: payload is not valid JSON: {exc}\n")
        return EXIT_USAGE
    try:
        payload = validate_payload(ns.action, raw)
    except PayloadError as exc:
        sys.stderr.write(f"{PROG}: invalid payload for {ns.action}: {exc}\n")
        log.error("rejected payload for %s: %s", ns.action, exc)
        return EXIT_USAGE

    if not dry_run and not is_root():
        sys.stderr.write(f"{PROG}: must run as root — call it through pkexec "
                         f"(lindos.helper.run_privileged) or set {DRYRUN_ENV}=1 to preview.\n")
        return EXIT_ERROR

    caller = os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID") or str(getattr(os, "getuid", lambda: -1)())
    logged_payload = _redact_for_log(ns.action, payload)
    log.info("=== %s %s (uid %s%s)", ns.action, json.dumps(logged_payload, sort_keys=True), caller,
             ", dry-run" if dry_run else "")
    ctx = Ctx(dry_run)
    if dry_run:
        ctx.say(f"[dry-run] {ns.action} {json.dumps(logged_payload, sort_keys=True)}")
    try:
        code = HANDLERS[ns.action](ctx, payload)
    except KeyboardInterrupt:
        ctx.error("interrupted")
        code = EXIT_ERROR
    except Exception as exc:  # last resort: never leak a traceback to pkexec callers without logging it
        log.exception("unhandled error in %s", ns.action)
        ctx.error(f"{ns.action}: {exc}")
        code = EXIT_ERROR
    log.info("=== %s exit %s", ns.action, code)
    return code


if __name__ == "__main__":
    sys.exit(main())
