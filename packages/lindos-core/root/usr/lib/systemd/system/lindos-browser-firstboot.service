[Unit]
Description=Lindos: silent retry of the Google Chrome install (installed system only)
Documentation=man:lindos-browser(1)
# Google's licence forbids redistributing Chrome inside the ISO (SPEC §0.1), so it is never on the
# live/build image.  The INSTALLER downloads it from Google's official apt repository while
# installing (its result is recorded in /var/lib/lindos/install-state.json, step 'browser'); this
# oneshot is only the SILENT background retry for when that did not work (offline install, a
# timeout, a failure).  browser-firstboot.sh reads install-state first: 'done'/'skipped' -> it
# writes the marker and exits at once; 'pending'/'failed'/unknown -> it retries through the same
# install-browser.sh helper the OOBE and 'lindos-browser install chrome' use.  It never shows a
# window or a wizard.
# It must never run in the live/ISO session: ConditionKernelCommandLine refuses to start while
# 'boot=casper' (or 'boot=live') is on the kernel command line (casper is Mint/Ubuntu's
# live-session bootstrap — present only when booted straight off the ISO, never on an installed
# system).  It must not run before the new user has finished Ubiquity's oem-config first-boot
# wizard either: while that is armed, /lib/systemd/system/oem-config.target exists (oem-config-
# firstboot deletes it as its very last step, right before it isolates graphical.target).
# Guarded by a marker file so it only ever runs to completion once; when offline (or the vendor
# repository is briefly unreachable) it exits WITHOUT writing the marker, so systemd retries it
# again on the next boot. NetworkManager-wait-online is masked on Lindos, so network-online.target
# is reached before Wi-Fi/DHCP is up: the script waits for NetworkManager itself (wait-for-network,
# bounded) before it calls the machine offline. Firefox stays the offline fallback (already on the
# ISO); the user can still pick Edge/Firefox any time in Lindos Settings.
# apt does not queue by itself and lindos-driver-firstboot.service (lindos-gaming) is queued in the same
# transaction: that unit is ordered AFTER this one, and install-browser.sh also takes its turn behind every
# other Lindos apt job (apt-serialise, a flock) and passes DPkg::Lock::Timeout to every apt-get, so a
# lock somebody else holds is waited for instead of failing the install.
ConditionKernelCommandLine=!boot=casper
ConditionKernelCommandLine=!boot=live
ConditionPathExists=!/lib/systemd/system/oem-config.target
ConditionPathExists=!/var/lib/lindos/browser-firstboot.done
ConditionVirtualization=!container
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/lindos/browser-firstboot.sh
# Best effort: never block or delay reaching the desktop.  Room for up to 3 minutes of queueing behind
# another apt job, 5 of waiting for a held dpkg lock and the download itself.
TimeoutStartSec=900
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
