#!/usr/bin/python3
"""lindos-browser — choose / install / default the web browser (SPEC §4.4, §4.10).

  lindos-browser list [--json]              Edge, Chrome, Firefox: installed? on the ISO?
  lindos-browser get  [--json]              effective browser (config) + xdg default
  lindos-browser install <edge|chrome|firefox> [--set-default] [--json]
        Edge/Chrome are downloaded from Microsoft's / Google's official apt repositories
        (needs internet + admin password via polkit); Firefox is Mint's .deb on the ISO.
  lindos-browser set-default <edge|chrome|firefox>
  lindos-browser status [--json]            online? installed set? default?

Exit codes: 0 ok · 1 error (install failed, offline, unknown id) · 2 usage.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from typing import Any, List, Optional

_HERE = os.path.dirname(os.path.abspath(__file__))
_TREE_LIB = os.path.normpath(os.path.join(_HERE, "..", "lib", "python3", "dist-packages"))
if os.path.isdir(os.path.join(_TREE_LIB, "lindos")) and _TREE_LIB not in sys.path:
    sys.path.insert(0, _TREE_LIB)

try:
    from lindos import __version__ as LINDOS_VERSION
    from lindos import browsers as lbrowsers
    from lindos import config as lconfig
except ImportError as exc:  # pragma: no cover
    sys.stderr.write(f"lindos-browser: the 'lindos' python package is missing ({exc}); install lindos-core\n")
    sys.exit(1)

PROG = "lindos-browser"
EXIT_OK, EXIT_ERROR, EXIT_USAGE = 0, 1, 2

for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(errors="replace")  # type: ignore[union-attr]
    except (AttributeError, ValueError):
        pass


def _emit(data: Any) -> None:
    print(json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False))


def cmd_list(ns: argparse.Namespace) -> int:
    rows = lbrowsers.list_browsers()
    if ns.json:
        _emit(rows)
        return EXIT_OK
    effective = lconfig.effective_browser()
    for row in rows:
        mark = "*" if row["id"] == effective else " "
        state = "installed" if row["installed"] else "not installed"
        print(f"{mark} {row['id']:<8} {row['name']:<16} {state:<14} {row['note']}")
    print(f"\n* = chosen ({effective}).  Install with: {PROG} install <id>")
    return EXIT_OK


def cmd_get(ns: argparse.Namespace) -> int:
    effective = lconfig.effective_browser()
    default = lbrowsers.default_browser()
    if ns.json:
        _emit({"browser": effective, "name": lbrowsers.BROWSERS[effective]["name"],
               "installed": lbrowsers.is_installed(effective), "xdg_default": default})
    else:
        print(effective)
    return EXIT_OK


def cmd_install(ns: argparse.Namespace) -> int:
    lines: List[str] = []

    def log(msg: str) -> None:
        lines.append(msg)
        if not ns.json:
            print(msg, flush=True)

    ok = lbrowsers.install(ns.browser, log=log)
    default_ok: Optional[bool] = None
    if ok and ns.set_default:
        default_ok = lbrowsers.set_default(ns.browser)
        log(f"default browser: {'set' if default_ok else 'could not be set (xdg-settings missing?)'}")
    if ns.json:
        _emit({"browser": ns.browser, "ok": ok, "installed": lbrowsers.is_installed(ns.browser),
               "set_default": default_ok, "log": lines, "online": lbrowsers.online()})
    elif not ok:
        sys.stderr.write(f"{PROG}: {lbrowsers.BROWSERS[ns.browser]['name']} was not installed\n")
    return EXIT_OK if ok else EXIT_ERROR


def cmd_set_default(ns: argparse.Namespace) -> int:
    if not lbrowsers.is_installed(ns.browser):
        sys.stderr.write(f"{PROG}: {lbrowsers.BROWSERS[ns.browser]['name']} is not installed "
                         f"(run: {PROG} install {ns.browser})\n")
        return EXIT_ERROR
    ok = lbrowsers.set_default(ns.browser)
    if ns.json:
        _emit({"browser": ns.browser, "ok": ok, "xdg_default": lbrowsers.default_browser()})
    elif ok:
        print(f"{lbrowsers.BROWSERS[ns.browser]['name']} is now the default browser")
    else:
        sys.stderr.write(f"{PROG}: could not fully set the default (see log); config updated\n")
    return EXIT_OK if ok else EXIT_ERROR


def cmd_status(ns: argparse.Namespace) -> int:
    effective = lconfig.effective_browser()
    data = {
        "online": lbrowsers.online(),
        "chosen": effective,
        "chosen_installed": lbrowsers.is_installed(effective),
        "xdg_default": lbrowsers.default_browser(),
        "installed": [b for b in lbrowsers.BROWSERS if lbrowsers.is_installed(b)],
        "note": "Edge/Chrome are downloaded from the vendor's apt repository at setup; Firefox ships on the ISO.",
    }
    if ns.json:
        _emit(data)
    else:
        print(f"online:          {'yes' if data['online'] else 'no'}")
        print(f"chosen:          {effective} ({'installed' if data['chosen_installed'] else 'NOT installed'})")
        print(f"xdg default:     {data['xdg_default'] or 'unknown'}")
        print(f"installed:       {', '.join(data['installed']) or 'none detected'}")
        print(f"note:            {data['note']}")
    return EXIT_OK


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROG, description="Choose, install and default the Lindos web browser.")
    parser.add_argument("--version", action="version", version=f"{PROG} {LINDOS_VERSION}")
    sub = parser.add_subparsers(dest="command", metavar="command")
    ids = list(lbrowsers.BROWSERS)
    p = sub.add_parser("list", help="list browsers")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)
    p = sub.add_parser("get", help="print the chosen browser id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_get)
    p = sub.add_parser("install", help="install a browser (vendor repo for Edge/Chrome)")
    p.add_argument("browser", choices=ids)
    p.add_argument("--set-default", action="store_true", help="also make it the default browser")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_install)
    p = sub.add_parser("set-default", help="make a browser the default")
    p.add_argument("browser", choices=ids)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_set_default)
    p = sub.add_parser("status", help="online / installed / default overview")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_status)
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    ns = parser.parse_args(argv)
    if not getattr(ns, "func", None):
        parser.print_help()
        return EXIT_USAGE
    try:
        return int(ns.func(ns))
    except KeyboardInterrupt:
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
