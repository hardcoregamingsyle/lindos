#!/bin/sh
# postinst for lindos-core — idempotent (SPEC §1.1)
set -e

LOG_DIR="/var/log/lindos"
HELPER="/usr/libexec/lindos/lindos-helper"
INSTALL_BROWSER="/usr/libexec/lindos/install-browser.sh"
BROWSER_FIRSTBOOT="/usr/libexec/lindos/browser-firstboot.sh"
UPDATE_NOTIFY="/usr/libexec/lindos/lindos-update-notify.sh"
IS_LIVE_SESSION="/usr/libexec/lindos/is-live-session"
OEM_CONFIG_PENDING="/usr/libexec/lindos/oem-config-pending"
WAIT_FOR_NETWORK="/usr/libexec/lindos/wait-for-network"
APT_SERIALISE="/usr/libexec/lindos/apt-serialise"
UPDATE_REFRESH="/usr/libexec/lindos/update-refresh"
UPDATE_REPAIR="/usr/libexec/lindos/update-repair"
REBOOT_HOOK="/usr/libexec/lindos/reboot-required-hook"
STATE_DIR="/var/lib/lindos"
LIVE_INHIBIT_UNIT="/usr/lib/systemd/system/lindos-live-inhibit.service"
LIVE_INHIBIT_WANTS="/usr/lib/systemd/system/multi-user.target.wants"
PYLIB="/usr/lib/python3/dist-packages/lindos"
SYSTEM_CONF="/etc/lindos/system.json"
USER_TIMER_WANTS="/usr/lib/systemd/user/timers.target.wants"
SYSTEM_TIMER_WANTS="/usr/lib/systemd/system/timers.target.wants"
UPDATE_REFRESH_TIMER="/usr/lib/systemd/system/lindos-update-refresh.timer"
UPDATE_REPAIR_UNIT="/usr/lib/systemd/system/lindos-update-repair.service"

case "$1" in
    configure)
        # log directory for the helper (root only writes, everyone may read the log)
        mkdir -p "$LOG_DIR"
        chmod 0755 "$LOG_DIR"
        touch "$LOG_DIR/helper.log"
        chmod 0644 "$LOG_DIR/helper.log"

        # helper + scripts must be executable (mkdeb fixes perms, but be safe on manual installs)
        chmod 0755 "$HELPER" "$INSTALL_BROWSER" 2>/dev/null || true
        [ -f "$BROWSER_FIRSTBOOT" ] && chmod 0755 "$BROWSER_FIRSTBOOT" 2>/dev/null || true
        [ -f "$UPDATE_NOTIFY" ] && chmod 0755 "$UPDATE_NOTIFY" 2>/dev/null || true
        [ -f "$IS_LIVE_SESSION" ] && chmod 0755 "$IS_LIVE_SESSION" 2>/dev/null || true
        [ -f "$OEM_CONFIG_PENDING" ] && chmod 0755 "$OEM_CONFIG_PENDING" 2>/dev/null || true
        [ -f "$WAIT_FOR_NETWORK" ] && chmod 0755 "$WAIT_FOR_NETWORK" 2>/dev/null || true
        [ -f "$APT_SERIALISE" ] && chmod 0755 "$APT_SERIALISE" 2>/dev/null || true
        [ -f "$UPDATE_REFRESH" ] && chmod 0755 "$UPDATE_REFRESH" 2>/dev/null || true
        [ -f "$UPDATE_REPAIR" ] && chmod 0755 "$UPDATE_REPAIR" 2>/dev/null || true
        [ -f "$REBOOT_HOOK" ] && chmod 0755 "$REBOOT_HOOK" 2>/dev/null || true

        # install-state.json (lindos.installstate) lives here; the installer writes it, the
        # first-boot retries and Settings read it.
        mkdir -p "$STATE_DIR"
        chmod 0755 "$STATE_DIR"

        # lindos-live-inhibit.service only ever starts in the live USB session (its own
        # ConditionKernelCommandLine); vendor-enable it with a static ".wants" symlink, the same way
        # the user timer below is, so it does not depend on the systemd preset having run.
        if [ -f "$LIVE_INHIBIT_UNIT" ]; then
            mkdir -p "$LIVE_INHIBIT_WANTS"
            ln -sf ../lindos-live-inhibit.service "$LIVE_INHIBIT_WANTS/lindos-live-inhibit.service"
        fi
        # The update system (SPEC-UPDATE.md §39): the root timer that refreshes the package lists twice a
        # day (the stock apt-daily timers are switched off on Lindos) and the boot-time repair of an
        # interrupted upgrade. Enabled with static ".wants" symlinks like the unit above, so they do not
        # depend on the systemd preset having run. Neither ever installs anything by itself.
        if [ -f "$UPDATE_REFRESH_TIMER" ]; then
            mkdir -p "$SYSTEM_TIMER_WANTS"
            ln -sf ../lindos-update-refresh.timer "$SYSTEM_TIMER_WANTS/lindos-update-refresh.timer"
        fi
        if [ -f "$UPDATE_REPAIR_UNIT" ]; then
            mkdir -p "$LIVE_INHIBIT_WANTS"
            ln -sf ../lindos-update-repair.service "$LIVE_INHIBIT_WANTS/lindos-update-repair.service"
        fi
        for cli in lindos-mode lindos-browser lindos-config lindos-ram lindos-dualboot lindos-update; do
            [ -f "/usr/bin/$cli" ] && chmod 0755 "/usr/bin/$cli"
        done

        # lindos-update-notify.timer (a systemd --user unit, SPEC-UPDATE.md §37): enable it by
        # default for every user the same way a vendor default is normally expressed for user
        # units -- a static ".wants" symlink -- since there is no logged-in user session at
        # package-install time to run 'systemctl --user enable' against. Read-only/unprivileged
        # either way: this only schedules lindos-update-notify.sh, which never elevates.
        if [ -f /usr/lib/systemd/user/lindos-update-notify.timer ]; then
            mkdir -p "$USER_TIMER_WANTS"
            ln -sf ../lindos-update-notify.timer "$USER_TIMER_WANTS/lindos-update-notify.timer"
        fi

        # default system config (conffile — only created when missing)
        if [ ! -f "$SYSTEM_CONF" ]; then
            mkdir -p /etc/lindos
            printf '{\n  "browser": "chrome",\n  "mode": "everyday",\n  "oem": false\n}\n' > "$SYSTEM_CONF"
        fi
        chmod 0644 "$SYSTEM_CONF"

        # byte-compile the python module (never fatal: python3 may be a different minor version)
        if command -v py3compile >/dev/null 2>&1; then
            py3compile -p lindos-core "$PYLIB" 2>/dev/null || true
        elif command -v python3 >/dev/null 2>&1; then
            python3 -m compileall -q "$PYLIB" 2>/dev/null || true
        fi
        # the CLIs are python scripts without .py, compile them too
        if command -v python3 >/dev/null 2>&1; then
            python3 -m py_compile "$HELPER" /usr/bin/lindos-mode /usr/bin/lindos-browser \
                /usr/bin/lindos-config /usr/bin/lindos-ram /usr/bin/lindos-dualboot \
                /usr/bin/lindos-update 2>/dev/null || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

exit 0
