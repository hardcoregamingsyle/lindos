#!/bin/sh
# postrm for lindos-core — idempotent (SPEC §1.1)
set -e

PYLIB="/usr/lib/python3/dist-packages/lindos"

case "$1" in
    remove|upgrade|deconfigure|abort-install|abort-upgrade|disappear|failed-upgrade)
        # drop stale byte-code (dpkg does not track __pycache__)
        if [ -d "$PYLIB/__pycache__" ]; then
            rm -rf "$PYLIB/__pycache__"
        fi
        if command -v py3clean >/dev/null 2>&1; then
            py3clean -p lindos-core 2>/dev/null || true
        fi
        ;;
    purge)
        rm -rf "$PYLIB/__pycache__" 2>/dev/null || true
        rm -f /var/log/lindos/helper.log /var/log/lindos/install-browser.log 2>/dev/null || true
        rmdir /var/log/lindos 2>/dev/null || true
        rm -f /etc/lindos/system.json 2>/dev/null || true
        rmdir /etc/lindos 2>/dev/null || true
        rm -f /etc/sysctl.d/90-lindos-mode.conf 2>/dev/null || true
        ;;
esac

exit 0
